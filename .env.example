NODE_ENV=production
PORT=3000
PUBLIC_URL=https://menuao.online
# Use a persistent directory outside the deployment checkout. Back up daily.
DATA_DIR=/absolute/persistent/path/menuao
# Set to the exact number of trusted reverse proxies in your Hostinger setup.
TRUST_PROXY_HOPS=1

# Required: 32 cryptographically random bytes encoded in hexadecimal; preserve this key in backups.
MFA_ENCRYPTION_KEY=
# First deployment only: independent random 64-character hex invitations, valid for 48 hours.
STAFF_ADMIN_ACTIVATION=
STAFF_MANAGER_ACTIVATION=
