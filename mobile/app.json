{
  "expo": {
    "name": "Menu Online",
    "slug": "menu-online-muds",
    "version": "1.0.0",
    "scheme": "menuonline",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ao.muds.menuonline",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Ler o QR Code de um menu.",
        "NSPhotoLibraryUsageDescription": "Escolher uma fotografia de produto."
      }
    },
    "android": {
      "package": "ao.muds.menuonline",
      "permissions": ["CAMERA"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolher uma fotografia de produto.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ler o QR Code de um menu.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "platforms": ["ios", "android"]
  }
}
